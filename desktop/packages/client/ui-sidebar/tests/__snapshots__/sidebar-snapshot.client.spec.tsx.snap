// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="88020f34"
          fill="none"
          height="16"
          stroke-width="1"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <span
      class="root newSessionMenu"
    >
      <button
        aria-label="New session"
        class="newSession"
        type="button"
      >
        <span
          class="newSessionLabelMask"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="47b5e433"
              fill="none"
              height="16"
              stroke-width="1"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
          </span>
        </span>
      </button>
    </span>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="New session"
        class="brand wide"
        type="button"
      >
        <span
          aria-hidden="true"
          class="brandIdentity"
        >
          <span
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <span
                class="seal"
                style="width: 24px; height: 24px;"
              >
                <img
                  alt=""
                  class="sealImage"
                  height="24"
                  src="data:image/svg+xml,%3c?xml%20version='1.0'%20encoding='UTF-8'?%3e%3csvg%20xmlns='http://www.w3.org/2000/svg'%20width='1024'%20height='1024'%20viewBox='0%200%201024%201024'%20fill='none'%3e%3ctitle%3eCadre%20Heihei%20·%20家印笑脸%20·%20标准%3c/title%3e%3crect%20x='56'%20y='56'%20width='912'%20height='912'%20rx='180'%20fill='%23F4F7FA'/%3e%3cpath%20d='M%20505%20770%20L%20272%20770%20Q%20260%20770%20260%20758%20L%20260%20244%20Q%20260%20232%20272%20232%20L%20748%20232%20Q%20760%20232%20760%20244%20L%20760%20696'%20stroke='%230E141B'%20stroke-width='44'%20stroke-linecap='round'%20stroke-linejoin='round'/%3e%3ccircle%20cx='392'%20cy='405'%20r='34'%20fill='%230E141B'/%3e%3cpath%20d='M%20558%20434%20Q%20619%20366%20680%20434'%20stroke='%230E141B'%20stroke-width='44'%20stroke-linecap='round'/%3e%3cpath%20d='M%20350%20545%20C%20400%20705%20620%20705%20672%20545'%20stroke='%230E141B'%20stroke-width='44'%20stroke-linecap='round'%20fill='none'/%3e%3crect%20x='690'%20y='720'%20width='68'%20height='68'%20rx='12'%20fill='%232B4C6F'/%3e%3c/svg%3e"
                  width="24"
                />
              </span>
            </div>
          </span>
          <span
            class="brandName"
          >
            <div
              data-slot="sidebar.brand.name"
              style="display: contents;"
            >
              <span
                class="name"
              >
                Cadre Heihei
              </span>
            </div>
          </span>
        </span>
      </button>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="88020f34"
          fill="none"
          height="16"
          stroke-width="1"
          viewBox="0 0 16 16"
          width="16"
          xmlns="http://www.w3.org/2000/svg"
        />
      </button>
    </div>
    <span
      class="root newSessionMenu"
    >
      <button
        aria-label="New session"
        class="newSession"
        type="button"
      >
        <span
          class="newSessionLabelMask"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="47b5e433"
              fill="none"
              height="14"
              stroke-width="1.3"
              viewBox="0 0 16 16"
              width="14"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span
              class="newSessionLabel wide"
            >
              New Session
            </span>
          </span>
        </span>
      </button>
    </span>
    <div
      class="regionArea"
    >
      <div
        data-slot="sidebar.workspaces"
        style="display: contents;"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footerActions"
      >
        <div
          data-slot="sidebar.footer.action"
          style="display: contents;"
        />
      </div>
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
    </div>
  </div>
</div>
`;

