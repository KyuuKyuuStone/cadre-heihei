{
  "name": "@deepseek-ai/dsh-bundle-cadre",
  "description": "Cadre employee templates: four agent presets (development, fiction writing, general assistant, role-play) declared as bundle rows",
  "version": "0.9.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib/**",
    "!lib/**/*.map"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-collab": "workspace:*",
    "@deepseek-ai/dsh-host-governance": "workspace:*"
  }
}
