# Copy this file to .env.windows and fill in the values for this machine.
# The template is tracked; the copied local file is ignored by Git.
# The example.com values are placeholders: they satisfy the packaging
# configuration check on a fresh machine, but they do not reach a real
# deployment. Replace DOWNLOAD_TEST_ORIGIN and DOWNLOAD_TEST_RELEASE_ID with
# this deployment's real download origin and release ID before signing or
# distributing any package.

DSH_DESKTOP_APP_ID=com.cadre.heihei
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# Test deployment. For production, set the environment to production, use
# DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN, and set the config to '{}'.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://policy.example.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Placeholder values required by the test-deployment configuration check
# (desktop-auto-update-environment.mjs:152-158). They are not a real download
# source: replace both before signing or upload.
DOWNLOAD_TEST_ORIGIN=https://download.example.com
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000

# Optional absolute private cache directory; omit to retain target-local storage.
# DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
DSH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4

# Signed Windows builds also need these values:
# DSH_DESKTOP_WINDOWS_CER_FILE=
# DSH_DESKTOP_WINDOWS_SIGNTOOL=
# DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
# DSH_DESKTOP_WINDOWS_TOKEN_PIN=
