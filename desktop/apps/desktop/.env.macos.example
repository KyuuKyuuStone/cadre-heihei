# Copy this file to .env.macos and fill in the values for this machine.
# The template is tracked; the copied local file is ignored by Git.
# Local unsigned macOS builds do not read this file. The example.com values are
# placeholders: they satisfy the packaging configuration check on a fresh
# machine, but they do not reach a real deployment. Replace DOWNLOAD_TEST_ORIGIN
# and DOWNLOAD_TEST_RELEASE_ID with this deployment's real download origin and
# release ID before signing or distributing any package.

DSH_DESKTOP_APP_ID=com.cadre.heihei
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# Test deployment. For production, set the environment to production, use
# DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN, and set the config to '{}'.
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://policy.example.com
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://login.example.com"]}'

# Placeholder values required by the test-deployment configuration check
# (desktop-auto-update-environment.mjs:152-158). They are not a real download
# source: replace both before signing or upload.
DOWNLOAD_TEST_ORIGIN=https://download.example.com
DOWNLOAD_TEST_RELEASE_ID=00000000000000000000000000000000

DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

# Optional absolute private cache directory; omit to retain target-local storage.
# DSH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=

# Signed macOS builds also need one signing identity and one notarization strategy:
# DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
# DSH_DESKTOP_MACOS_TEAM_ID=
# CSC_LINK=
# CSC_KEY_PASSWORD=
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
# APPLE_KEYCHAIN_PROFILE=
# APPLE_KEYCHAIN=
