{
  "name": "@cadre-heihei/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "gates": "node scripts/gates/run-all.ts",
    "gates:file-size": "node scripts/gates/check-file-size.ts",
    "gates:imports": "node scripts/gates/check-import-semantics.ts",
    "gates:tsc": "node scripts/gates/check-tsc-baseline.ts",
    "gates:smoke": "node scripts/gates/smoke.ts",
    "gates:evidence": "node scripts/gates/two-state-evidence.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "harness:smoke": "node scripts/s7-harness-adapter/run.ts",
    "hooks:install": "node scripts/git-hooks/install.ts",
    "hooks:install:pre-commit": "node scripts/git-hooks/install-pre-commit.ts",
    "preflight": "node scripts/preflight-release.mjs --stage all"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  }
}
