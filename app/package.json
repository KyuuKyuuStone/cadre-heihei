{
  "name": "@cadre-heihei/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "gates": "node scripts/gates/run-all.ts",
    "gates:file-size": "node scripts/gates/check-file-size.ts",
    "gates:imports": "node scripts/gates/check-import-semantics.ts",
    "gates:tsc": "node scripts/gates/check-tsc-baseline.ts",
    "gates:smoke": "node scripts/gates/smoke.ts",
    "gates:evidence": "node scripts/gates/two-state-evidence.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:ui": "vitest run",
    "harness:smoke": "node scripts/s7-harness-adapter/run.ts",
    "harness:scan": "node scripts/s7-harness-adapter/security-scan.ts",
    "runtime:soak": "node scripts/m2-runtime-registry/soak.ts",
    "hooks:install": "node scripts/git-hooks/install.ts",
    "hooks:install:pre-commit": "node scripts/git-hooks/install-pre-commit.ts",
    "preflight": "node scripts/preflight-release.mjs --stage all"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "42.7.0",
    "electron-builder": "26.8.1",
    "jsdom": "^25.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
